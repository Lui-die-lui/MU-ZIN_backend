# 이 파일을 .env로 복사한 뒤 값을 채우세요. (.env는 git에 올라가지 않음)
DB_URL=jdbc:postgresql://localhost:3311/muzin_db
DB_USERNAME=
DB_PASSWORD=

# Base64 인코딩된 512bit(64byte) 이상 랜덤 키. 예: openssl rand -base64 64
JWT_SECRET=

# Gmail 앱 비밀번호
MAIL_USERNAME=
MAIL_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 선택 (기본값 있음)
# FRONTEND_URL=http://localhost:5173
# BACKEND_URL=http://localhost:8080
# SQL_LOG_LEVEL=DEBUG

# 샘플(시연용) 계정 레슨을 추천에 "샘플" 표시와 함께 보임 (로컬 개발만 true, 운영은 넣지 않음)
SHOW_SAMPLE_DATA=true

AI_MODEL=
AI_PROVIDER=
OPENAI_API=


# AI 레슨 내비게이터 (docs/ai/lesson-assistant.md)
# 실제 호출하려면 AI_PROVIDER=openai 와 OPENAI_API 를 둘 다 설정 (없으면 stub = 호출·과금 없음)
# AI_PROVIDER=openai
# OPENAI_API=
# AI_MODEL=gpt-6-luna
# AI_MONTHLY_BUDGET_USD=10
# 모델 단가 (USD / 100만 토큰) - openai 모드에서는 필수. 비어 있으면 호출하지 않음
# AI_PRICE_INPUT_USD_PER_MTOK=
# AI_PRICE_CACHED_INPUT_USD_PER_MTOK=
# AI_PRICE_OUTPUT_USD_PER_MTOK=
# AI_RETENTION_DAYS=90
