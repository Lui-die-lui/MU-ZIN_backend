# 이 파일을 .env로 복사한 뒤 값을 채우세요. (.env는 git에 올라가지 않음)
DB_URL=jdbc:postgresql://localhost:3311/muzin_db
DB_USERNAME=
DB_PASSWORD=

# Base64 인코딩된 512bit(64byte) 이상 랜덤 키. 예: openssl rand -base64 64
JWT_SECRET=

# Gmail 앱 비밀번호
MAIL_USERNAME=
MAIL_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 선택 (기본값 있음)
# FRONTEND_URL=http://localhost:5173
# BACKEND_URL=http://localhost:8080
# SQL_LOG_LEVEL=DEBUG
